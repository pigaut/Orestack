    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.pigaut.rpg</groupId>
    <artifactId>RpgMakerPlugin</artifactId>
    <packaging>jar</packaging>
    <version>4.0.0</version>
    <name>RpgMaker Plugin</name>
    <description>A minecraft plugin used to create rpg worlds and mechanics</description>
    <url>https://www.spigotmc.org/resources/121905/</url>

    <properties>
        <maven.compiler.source>16</maven.compiler.source>
        <maven.compiler.target>16</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mc.version>1.16.5</mc.version>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <minimizeJar>true</minimizeJar>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>io.github.pigaut.orestack.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                            <outputFile>
                                D:\files\Development\java\spigot\servers\${mc.version}\plugins\RpgMaker-${project.version}.jar
                            </outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

